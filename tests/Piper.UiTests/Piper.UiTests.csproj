<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives real WinForms controls from Piper.App, for behaviour that lives in the native
       controls and cannot be checked by the WinForms-free smoke tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Piper.App\Controls\ImageDecoding.cs" Link="ImageDecoding.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\ImageGuard.cs" Link="ImageGuard.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\WebpView.cs" Link="WebpView.cs" />
    <!-- WebpView.cs is compiled in, so the same WebView2 references as Piper.App are needed. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
    <ProjectReference Include="..\..\src\Piper.App\Piper.App.csproj" />
    <ProjectReference Include="..\..\src\Piper.Core\Piper.Core.csproj" />
    <Compile Include="..\..\src\Piper.App\WindowActivation.cs" Link="WindowActivation.cs" />
  </ItemGroup>

</Project>
