<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives real WinForms controls from Piper.App, for behaviour that lives in the native
       controls and cannot be checked by the WinForms-free smoke tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Piper.App\Controls\ImageDecoding.cs" Link="ImageDecoding.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\ImageGuard.cs" Link="ImageGuard.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\WebpView.cs" Link="WebpView.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\VideoView.cs" Link="VideoView.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\VideoRange.cs" Link="VideoRange.cs" />
    <!-- WebpView.cs and VideoView.cs are compiled in, so the same WebView2 references as Piper.App are needed. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
    <ProjectReference Include="..\..\src\Piper.App\Piper.App.csproj" />
    <ProjectReference Include="..\..\src\Piper.Core\Piper.Core.csproj" />
    <Compile Include="..\..\src\Piper.App\WindowActivation.cs" Link="WindowActivation.cs" />
    <Compile Include="..\..\src\Piper.App\Theme\StatusImages.cs" Link="StatusImages.cs" />
    <!-- The panel host and the internal types it is built from, for PanelHostTests. -->
    <Compile Include="..\..\src\Piper.App\Layout\PanelLayout.cs" Link="PanelLayout.cs" />
    <!-- The layout file, for the remembered session-column widths round trip. -->
    <Compile Include="..\..\src\Piper.App\WindowLayoutStore.cs" Link="WindowLayoutStore.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\PanelRegistry.cs" Link="PanelRegistry.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\PanelHost.cs" Link="PanelHost.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\PanelMenus.cs" Link="PanelMenus.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\SessionDrop.cs" Link="SessionDrop.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\FloatingPanelForm.cs" Link="FloatingPanelForm.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\AutoHideStrip.cs" Link="AutoHideStrip.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\Flyout.cs" Link="Flyout.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\TabDrag.cs" Link="TabDrag.cs" />
    <Compile Include="..\..\src\Piper.App\Layout\ToolWindowHeader.cs" Link="ToolWindowHeader.cs" />
    <Compile Include="..\..\src\Piper.App\TextInputFocus.cs" Link="TextInputFocus.cs" />
    <!-- The panel menus' labels, read from the same catalogue the app embeds. -->
    <Compile Include="..\..\src\Piper.App\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\..\src\Piper.App\I18n.cs" Link="I18n.cs" />
    <Compile Include="..\..\src\Piper.App\Menus.cs" Link="Menus.cs" />
    <EmbeddedResource Include="..\..\src\Piper.App\Locales\en.json" LogicalName="Piper.App.Locales.en.json" />
    <Compile Include="..\..\src\Piper.App\Theme\DarkTabControl.cs" Link="DarkTabControl.cs" />
    <Compile Include="..\..\src\Piper.App\Theme\DarkListView.cs" Link="DarkListView.cs" />
  </ItemGroup>

</Project>
