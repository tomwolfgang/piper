<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Piper.Core\Piper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Piper.App\UpdateService.cs" Link="UpdateService.cs" />
    <Compile Include="..\..\src\Piper.App\DiagnosticsBundle.cs" Link="DiagnosticsBundle.cs" />
    <Compile Include="..\..\src\Piper.App\SazFileRelay.cs" Link="SazFileRelay.cs" />
    <!-- UpdateService and DiagnosticsBundle report their failures with the app's shared string
         catalogue, so the tests link it in and exercise the same loader the app uses. -->
    <Compile Include="..\..\src\Piper.App\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\..\src\Piper.App\I18n.cs" Link="I18n.cs" />
    <!-- Free of WinForms, so the session list's size and progress text can be checked here. -->
    <Compile Include="..\..\src\Piper.App\Controls\Format.cs" Link="Format.cs" />
    <Compile Include="..\..\src\Piper.App\Controls\ColumnLayout.cs" Link="ColumnLayout.cs" />
    <EmbeddedResource Include="..\..\src\Piper.App\Locales\en.json" LogicalName="Piper.App.Locales.en.json" />
    <!-- The benchmark tool's result file and statistics; free of the proxy, so checked here. -->
    <Compile Include="..\..\tools\Piper.Bench\BenchStats.cs" Link="Bench\BenchStats.cs" />
    <Compile Include="..\..\tools\Piper.Bench\BenchRecord.cs" Link="Bench\BenchRecord.cs" />
    <Compile Include="..\..\tools\Piper.Bench\BenchReport.cs" Link="Bench\BenchReport.cs" />
  </ItemGroup>

</Project>
