<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development tool only: not referenced by the app, the tests or the installer, never shipped. This
         project is deliberately NOT in Piper.slnx; eng/verify.ps1 (and so CI and CodeQL) restores and builds it
         on its own so it keeps compiling, but nothing runs it. -->
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Piper.Core\Piper.Core.csproj" />
  </ItemGroup>

</Project>
