<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Piper</AssemblyName>
    <Version>0.11.0</Version>
    <RootNamespace>Piper.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\piper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piper.Core\Piper.Core.csproj" />
  </ItemGroup>

  <!-- S11 STOPGAP (PR "S11 bridge"): remove ALL FIVE items below the moment SixLabors.ImageSharp is
       upgraded or removed. They are not a verdict that 3.1.12 is safe.
       Why: every advisory is fixed only in 4.1.2, which needs a Six Labors licence key at Release
       build time; the secretless CI cannot build it, so the restore audit (NU1902/NU1903 as errors)
       failed every pull request. Whether to remove ImageSharp or license 4.x is still open.
       Decoder advisories a hostile captured body can reach through the inspector's image viewer. They
       are mitigated by ImageGuard (src/Piper.App/Controls/ImageGuard.cs, the companion "S11 bridge
       (2/2)" change), which refuses TIFF/BigTIFF and any embedded ICC profile before the library sees
       the bytes; until that lands they are suppressed but NOT mitigated:
         GHSA-gwg2-r3hj-4w44  ICC CLUT parsing allocates from unvalidated dimensions (Piper never
                              reads IccProfile.Entries, so this path is not reached even unguarded)
         GHSA-wmxv-xphr-5c9g  BigTIFF IFD count keeps a decoder thread in a non-progressing loop
       Not used by Piper (no TIFF CCITT encoding, no HistogramEqualization):
         GHSA-j3p4-wp97-rph4  HistogramEqualization unchecked index
         GHSA-j9gm-c75j-xc9q  TIFF CCITT T4 encoder writes past its buffer
         GHSA-jjfr-hcj7-qf5w  TIFF CCITT T6 encoder writes past its buffer
       This project references ImageSharp directly.
       Only these five advisories are suppressed; the audit stays on for everything else. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

  <ItemGroup>
    <!-- The i18next-format string catalogue. Embedded rather than copied beside the exe so it
         cannot be edited or replaced between builds; see the remarks on I18n. -->
    <EmbeddedResource Include="Locales\en.json" LogicalName="Piper.App.Locales.en.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Be.Windows.Forms.HexBox.Net8" Version="2.1.0" />
    <PackageReference Include="ShimmyMySherbet.WinForms.ZoomableImageBox" Version="1.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" Link="runtimes\win-x86\native\WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Link="runtimes\win-x64\native\WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" Link="runtimes\win-arm64\native\WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
